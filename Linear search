#include <stdio.h>

void main()
{
    int LOC;
    int flag = 0;
    int a[5], item, i;

    printf("Enter 5 elements:\n");

    for(i = 0; i <= 4; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter element to search: ");
    scanf("%d", &item);

    for(i = 0; i <= 4; i++)
    {
        if(a[i] == item)
        {
            flag = 1;
            LOC = i + 1;
            break;
        }
    }

    if(flag == 1)
    {
        printf("Element found at location %d", LOC);
    }
    else
    {
        printf("No Element found");
    }

    
}
